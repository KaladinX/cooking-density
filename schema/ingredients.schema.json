{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cooking-density ingredients.json",
  "type": "object",
  "required": ["schemaVersion", "source", "densityUnit", "compositionUnit", "ingredients"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["name", "release", "url", "license"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "release": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "densityUnit": { "const": "g/mL" },
    "compositionUnit": { "type": "string" },
    "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredient" } }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "required": ["id", "fdcId", "description", "category", "source", "forms"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "fdcId": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "source": { "const": "usda-sr-legacy" },
        "composition": { "$ref": "#/$defs/composition" },
        "forms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/form" } }
      }
    },
    "composition": {
      "type": "object",
      "required": ["water", "protein", "fat", "carbohydrate", "fiber", "ash", "sum", "carbohydrateByDifference"],
      "additionalProperties": false,
      "properties": {
        "water": { "type": "number", "minimum": 0 },
        "protein": { "type": "number", "minimum": 0 },
        "fat": { "type": "number", "minimum": 0 },
        "carbohydrate": { "type": "number", "minimum": 0 },
        "fiber": { "type": "number", "minimum": 0 },
        "ash": { "type": "number", "minimum": 0 },
        "sum": { "type": "number", "minimum": 0 },
        "carbohydrateByDifference": { "type": "number", "minimum": 0 },
        "missing": { "type": "array", "items": { "enum": ["fiber", "ash"] } }
      }
    },
    "form": {
      "type": "object",
      "required": ["form", "densityGPerMl", "basisPortionId", "portions"],
      "additionalProperties": false,
      "properties": {
        "form": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "densityGPerMl": { "type": "number", "exclusiveMinimum": 0 },
        "basisPortionId": { "type": "integer" },
        "portions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/portion" } }
      }
    },
    "portion": {
      "type": "object",
      "required": ["usdaPortionId", "amount", "modifier", "gramWeight", "unit", "volumeMl", "densityGPerMl"],
      "additionalProperties": false,
      "properties": {
        "usdaPortionId": { "type": "integer" },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "modifier": { "type": "string" },
        "gramWeight": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "pattern": "^[a-z-]+:[A-Za-z ]+$" },
        "volumeMl": { "type": "number", "exclusiveMinimum": 0 },
        "densityGPerMl": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
