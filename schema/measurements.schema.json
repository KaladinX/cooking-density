{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cooking-density measurements.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "note",
    "measurements"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    }
  },
  "$defs": {
    "length": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "in",
            "cm",
            "mm"
          ]
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "id",
        "contributor",
        "submittedOn",
        "ingredient",
        "description",
        "quantity",
        "value",
        "unit",
        "instrument",
        "conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "contributor": {
          "type": "string",
          "minLength": 1
        },
        "submittedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "ingredient": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "enum": [
            "mass-in-shell",
            "mass",
            "volume"
          ]
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "g",
            "mL"
          ]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "height": {
              "$ref": "#/$defs/length"
            },
            "width": {
              "$ref": "#/$defs/length"
            }
          }
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        },
        "sizeClaim": {
          "type": "object",
          "required": [
            "standard",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "standard": {
              "enum": [
                "us",
                "ca",
                "eu"
              ]
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
