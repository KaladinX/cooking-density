{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cooking-density units.json",
  "type": "object",
  "required": ["schemaVersion", "units"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "note": { "type": "string" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "name", "system", "kind", "ml"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z-]+:[A-Za-z ]+$" },
              "name": { "type": "string", "minLength": 1 },
              "system": { "enum": ["us-customary", "us-legal", "metric", "australian", "imperial"] },
              "kind": { "const": "volume" },
              "ml": { "type": "number", "exclusiveMinimum": 0 },
              "note": { "type": "string" }
            }
          },
          {
            "type": "object",
            "required": ["id", "name", "system", "kind", "grams"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z-]+:[A-Za-z -]+$" },
              "name": { "type": "string", "minLength": 1 },
              "system": { "enum": ["mass", "us-customary"] },
              "kind": { "const": "mass" },
              "grams": { "type": "number", "exclusiveMinimum": 0 },
              "note": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
